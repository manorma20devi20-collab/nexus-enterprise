FROM python:3.10-slim

# Working Directory सेट करें
WORKDIR /app

# सिस्टम की आवश्यक लाइब्रेरीज इंस्टॉल करें ताकि Chromium और Playwright बिना क्रैश के चल सकें
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libx11-xcb1 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pip को अपग्रेड करें
RUN pip install --no-cache-dir --upgrade pip

# रिक्वायरमेंट्स फाइल कॉपी करें और लाइब्रेरीज इंस्टॉल करें
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Playwright का Chromium ब्राउज़र बाइनरी इंस्टॉल करें
RUN playwright install chromium

# प्रोजेक्ट का पूरा कोड कंटेनर में कॉपी करें
COPY . .

# Render पोर्ट के अनुसार Flask ऐप रन करने की कमांड
EXPOSE 10000
CMD python app.py
