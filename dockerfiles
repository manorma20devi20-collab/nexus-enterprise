FROM python:3.10-slim

WORKDIR /app

# सिस्टम डिपेंडेंसीज इंस्टॉल करना ताकि OpenCV और Playwright स्मूथ चलें
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Playwright ब्राउज़र बाइनरी सेटअप
RUN playwright install --with-deps chromium

COPY . .

EXPOSE 10000

CMD ["gunicorn", "--bind", "0.0.0.0:10000", "app:app", "--workers", "2", "--threads", "4", "--timeout", "120"]
