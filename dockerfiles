FROM python:3.10-slim

# Working Directory सेट करें
WORKDIR /app

# सिस्टम डिपेंडेंसीज और प्लेराइट ब्राउज़र सेटअप
RUN apt-get update && apt-get install -y \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# पाइथन रिक्वायरमेंट्स कॉपी और इंस्टॉल करें
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install chromium

# प्रोजेक्ट कोड कॉपी करें
COPY . .

# Flask ऐप रन करें
CMD ["python", "app.py"]
