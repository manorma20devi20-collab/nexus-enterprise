# माइक्रोसॉफ्ट का आधिकारिक Playwright पाइथन इमेज जो क्रोमियम और सभी लिनक्स डिपेंडेंसीज के साथ आता है
FROM mcr.microsoft.com/playwright/python:v1.42.0-jammy

WORKDIR /app

# रिक्वायरमेंट फाइल कॉपी करें और पैकेज इंस्टॉल करें
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# पूरा प्रोजेक्ट कोड कॉपी करें
COPY . .

# रेंडर पोर्ट के साथ यूवीकर्न (Uvicorn) सर्वर शुरू करें
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "10000"]
